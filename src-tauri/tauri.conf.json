{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Desktop",
  "mainBinaryName": "DeepSeek Desktop",
  "version": "0.1.0",
  "identifier": "app.deepseek-desktop",
  "build": {
    "beforeDevCommand": "yarn web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeepSeek Desktop",
        "width": 920,
        "height": 680,
        "minWidth": 840,
        "minHeight": 600,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
