{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Desktop",
  "mainBinaryName": "DeepSeek Desktop",
  "version": "0.4.0",
  "identifier": "app.deepseek-desktop",
  "build": {
    "beforeDevCommand": "yarn web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn web:build && node scripts/prepare-npm-cache.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "DeepSeek Desktop",
        "width": 920,
        "height": 680,
        "minWidth": 840,
        "minHeight": 600,
        "shadow": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "trafficLightPosition": { "x": 13, "y": 14 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; frame-src http://127.0.0.1:*"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Buktal/deepseek-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5RjdCNjMzNERDRjdGOUMKUldTY2Y4OU5NN2IzV1dZaUtHL2Q3eXN1VTRnL0xGM2UydUo0ZVJFajBvSHZ0Qmd4QnBvWURpOVIK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/npm-cache": "npm-cache"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
